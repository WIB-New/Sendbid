{
  "expo": {
    "name": "SENDBID",
    "slug": "sendbid",
    "owner": "albertfas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sendbid",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sendbid.client",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner les QR codes de transfert",
        "NSPhotoLibraryUsageDescription": "Importer un avatar de profil",
        "NSLocationWhenInUseUsageDescription": "Suivre votre transfert VIP en temps réel",
        "NSContactsUsageDescription": "Sélectionner un bénéficiaire dans vos contacts",
        "NSFaceIDUsageDescription": "Connexion biométrique sécurisée"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00147E"
      },
      "package": "app.sendbid.client",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00147E"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7730c3d8-f109-491e-97fb-d55ab47b8bda"
      },
      "router": {}
    }
  }
}
